# Node Environment
NODE_ENV=production
PORT=3000

# ==============================================================================
# YouTube Authentication / Cookies Configuration
# ==============================================================================
# Tránh lỗi YouTube Bot Detection ("Sign in to confirm you're not a bot" / HTTP 429)
# khi deploy trên Datacenter IPs (DigitalOcean, AWS, GCP, Hetzner, etc.)
#
# Cách 1: Dán trực tiếp toàn bộ nội dung file cookies.txt (Netscape format) vào đây
# YOUTUBE_COOKIES_TEXT=
#
# Cách 2: Mã hóa Base64 nội dung file cookies.txt (chạy: base64 -w 0 cookies.txt)
# YOUTUBE_COOKIES_BASE64=
#
# Cách 3: Đường dẫn tuyệt đối tới file cookies.txt trên server
# YOUTUBE_COOKIES_FILE=/app/cookies.txt
